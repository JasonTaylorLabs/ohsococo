{
  "name": "ohsococo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "quality:dead": "knip",
    "quality:dup": "jscpd src",
    "quality:cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jscpd": "^4",
    "knip": "^6",
    "madge": "^8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "@vitest/coverage-v8": "5.0.3"
  }
}
